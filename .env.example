# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The one doctor email allowed to use the dashboard (server-side only).
# NOTE: NEXT_PUBLIC_DOCTOR_EMAIL is no longer used. Remove it from your host.
DOCTOR_EMAIL=

# EmailJS (booking emails)
EMAILJS_SERVICE_ID=
EMAILJS_PATIENT_TEMPLATE_ID=
EMAILJS_DOCTOR_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional
ENROLLMENT_FORM_URL=
